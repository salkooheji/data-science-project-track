---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CopyPromptButton from '../components/CopyPromptButton.astro';
import { getPhase } from '../data/phases';
import { renderInline } from '../lib/inlineCode';

interface Props {
  entry: CollectionEntry<'projects'>;
  prevEntry: CollectionEntry<'projects'> | null;
  nextEntry: CollectionEntry<'projects'> | null;
}

const { entry, prevEntry, nextEntry } = Astro.props;
const project = entry.data;
const phase = getPhase(project.phase);
const orderLabel = String(project.order).padStart(2, '0');
const hasContent = project.whatYouWillBuild !== undefined;
const choosingHeading = project.choosingYourDataHeading ?? 'Choosing your data';
const checklistCount = project.auditChecklist?.length ?? 0;

const AI_MODEL_NOTE =
  "Use a paid plan and the strongest model you have access to (Claude, ChatGPT or Gemini). These projects are long, and free tiers usually hit their limits partway and make more mistakes. If you're on a free plan, expect to work across several chats: use the summary the prompt gives you at the end of each session to pick up where you left off. If code gives an error, paste the full error back and ask it to explain the fix.";
---

<BaseLayout
  title={`${project.title} - projecttrack.dev`}
  description={project.summary}
>
  <article class="project" style={`--phase-color: ${phase.color};`}>
    <div class="meta">
      <span class="phase-badge">{phase.label}</span>
      <span class="order-label">Project {orderLabel}</span>
    </div>
    <h1>{project.title}</h1>
    <p class="lede">{project.summary}</p>

    {
      !hasContent && (
        <p class="coming-soon">This project page hasn't been written yet. Check back soon.</p>
      )
    }

    {
      hasContent && (
        <div class="sections">
          {project.whatYouWillBuild && (
            <section>
              <h2>What you'll build</h2>
              <p set:html={renderInline(project.whatYouWillBuild)} />
            </section>
          )}

          {project.whatItTeaches && project.whatItTeaches.length > 0 && (
            <section>
              <h2>What it teaches</h2>
              <ul class="plain-list">
                {project.whatItTeaches.map((item) => <li set:html={renderInline(item)} />)}
              </ul>
            </section>
          )}

          {project.stack && (
            <section>
              <h2>Stack</h2>
              <p set:html={renderInline(project.stack)} />
            </section>
          )}

          {project.prerequisites && (
            <section>
              <h2>Prerequisites</h2>
              <p set:html={renderInline(project.prerequisites)} />
            </section>
          )}

          {project.choosingYourData && (
            <section>
              <h2>{choosingHeading}</h2>
              <p set:html={renderInline(project.choosingYourData)} />
            </section>
          )}

          {project.deliverable && project.deliverable.length > 0 && (
            <section>
              <h2>The deliverable</h2>
              <ul class="plain-list">
                {project.deliverable.map((item) => <li set:html={renderInline(item)} />)}
              </ul>
            </section>
          )}

          {project.howLongItTakes && (
            <section>
              <h2>How long it takes</h2>
              <p set:html={renderInline(project.howLongItTakes)} />
            </section>
          )}

          {project.learnWithAIPrompt && (
            <section>
              <h2>Learn it with AI</h2>
              <p>Copy this prompt into an AI assistant and follow along.</p>
              <p class="ai-model-note">{AI_MODEL_NOTE}</p>
              <div class="prompt-block">
                <div class="prompt-toolbar">
                  <span>Prompt</span>
                  <CopyPromptButton targetId="ai-prompt" />
                </div>
                <pre><code id="ai-prompt">{project.learnWithAIPrompt}</code></pre>
              </div>
            </section>
          )}

          {project.auditChecklist && project.auditChecklist.length > 0 && (
            <section>
              <h2>Audit checklist</h2>
              <p>Check your own work against these before calling it done:</p>
              <ul class="checklist" data-checklist data-slug={entry.id}>
                {project.auditChecklist.map((item, i) => (
                  <li>
                    <label>
                      <input type="checkbox" data-index={i} />
                      <span set:html={renderInline(item)} />
                    </label>
                  </li>
                ))}
              </ul>
              <p class="storage-note">
                Your ticks are saved in this browser only.
                <button type="button" class="link-btn" data-clear-checklist>Clear</button>
              </p>
            </section>
          )}

          {project.shareYourWork && (
            <section>
              <h2>Share your work</h2>
              <p set:html={renderInline(project.shareYourWork)} />
            </section>
          )}

          {project.doneRightLooksLike && (
            <section>
              <h2>Done right looks like</h2>
              <p set:html={renderInline(project.doneRightLooksLike)} />
            </section>
          )}

          <section class="progress-section" data-slug={entry.id}>
            <h2>Your progress</h2>
            <div class="progress-row">
              <button type="button" class="mark-done-btn" data-mark-done>
                Mark this project as done
              </button>
              {
                checklistCount > 0 && (
                  <span class="checklist-count" data-checklist-count>
                    0 of {checklistCount} checks ticked
                  </span>
                )
              }
            </div>
            <p class="all-done-note" data-all-done-note hidden>
              All checks done. Mark this project as done?
            </p>
          </section>
        </div>
      )
    }

    <nav class="project-nav">
      {
        prevEntry ? (
          <a href={`/projects/${prevEntry.id}/`} class="nav-link prev">
            <span class="nav-label">&larr; Previous</span>
            <span class="nav-title">{prevEntry.data.title}</span>
          </a>
        ) : (
          <span class="nav-spacer" aria-hidden="true" />
        )
      }
      {
        nextEntry ? (
          <a href={`/projects/${nextEntry.id}/`} class="nav-link next">
            <span class="nav-label">Next &rarr;</span>
            <span class="nav-title">{nextEntry.data.title}</span>
          </a>
        ) : (
          <span class="nav-spacer" aria-hidden="true" />
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  import { clearChecklistState, getChecklistState, isProjectDone, setChecklistState, setProjectDone } from '../lib/progress';

  const checklistEl = document.querySelector<HTMLUListElement>('[data-checklist]');
  const countEl = document.querySelector<HTMLElement>('[data-checklist-count]');
  const allDoneNote = document.querySelector<HTMLElement>('[data-all-done-note]');

  if (checklistEl) {
    const slug = checklistEl.dataset.slug ?? '';
    const checkboxes = Array.from(checklistEl.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const total = checkboxes.length;

    const updateCount = () => {
      const ticked = checkboxes.filter((cb) => cb.checked).length;
      if (countEl) countEl.textContent = `${ticked} of ${total} checks ticked`;
      if (allDoneNote) allDoneNote.hidden = total === 0 || ticked !== total;
    };

    const saved = getChecklistState(slug);
    checkboxes.forEach((cb, i) => {
      cb.checked = Boolean(saved[i]);
      cb.addEventListener('change', () => {
        setChecklistState(slug, checkboxes.map((c) => c.checked));
        updateCount();
      });
    });
    updateCount();

    const clearButton = document.querySelector<HTMLButtonElement>('[data-clear-checklist]');
    clearButton?.addEventListener('click', () => {
      checkboxes.forEach((cb) => {
        cb.checked = false;
      });
      clearChecklistState(slug);
      updateCount();
    });
  }

  const markDoneBtn = document.querySelector<HTMLButtonElement>('[data-mark-done]');
  const progressSection = document.querySelector<HTMLElement>('.progress-section');
  if (markDoneBtn && progressSection) {
    const slug = progressSection.dataset.slug ?? '';

    const renderDoneState = () => {
      const done = isProjectDone(slug);
      markDoneBtn.textContent = done ? 'Marked as done (click to unmark)' : 'Mark this project as done';
      markDoneBtn.classList.toggle('is-done', done);
    };

    markDoneBtn.addEventListener('click', () => {
      setProjectDone(slug, !isProjectDone(slug));
      renderDoneState();
    });
    renderDoneState();
  }
</script>

<style>
  .project {
    width: min(100% - 48px, 760px);
    margin-inline: auto;
    padding-block: 64px 100px;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 20px;
  }
  .phase-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--phase-color);
    border: 1px solid color-mix(in srgb, var(--phase-color) 40%, transparent);
    background: color-mix(in srgb, var(--phase-color) 10%, transparent);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .order-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    color: var(--color-heading);
  }
  .lede {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 48px;
  }
  .coming-soon {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    border: 1px dashed var(--color-border-hover);
    border-radius: 12px;
    padding: 20px 24px;
    margin: 0 0 48px;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 44px;
    margin-bottom: 56px;
  }
  section h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.015em;
    color: var(--color-heading);
    margin: 0 0 14px;
  }
  section p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 12px;
  }
  section p:last-child {
    margin-bottom: 0;
  }
  section :global(code.inline-code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }

  .ai-model-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 0 0 16px;
  }

  .plain-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plain-list li {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .checklist li {
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    border-radius: 10px;
  }
  .checklist label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
  }
  .checklist input[type='checkbox'] {
    margin-top: 4px;
    width: 16px;
    height: 16px;
    accent-color: var(--phase-color);
    flex-shrink: 0;
  }
  .checklist span {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .storage-note {
    font-size: 13px;
    color: var(--color-muted);
    margin: 12px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .link-btn {
    font: inherit;
    font-size: 13px;
    color: var(--color-accent);
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .link-btn:hover {
    color: var(--color-accent-hover);
  }

  .prompt-block {
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    border-radius: 12px;
    overflow: hidden;
  }
  .prompt-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .prompt-block pre {
    margin: 0;
    padding: 20px;
    overflow-x: auto;
    max-height: 520px;
    overflow-y: auto;
  }
  .prompt-block code {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-text);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .progress-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .mark-done-btn {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-heading);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 10px 20px;
    cursor: pointer;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }
  .mark-done-btn:hover {
    background: var(--color-card-bg-hover);
    border-color: var(--color-border-hover);
  }
  .mark-done-btn.is-done {
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .checklist-count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
  .all-done-note {
    font-size: 14px;
    color: var(--phase-color);
    margin: 14px 0 0;
  }

  .project-nav {
    display: flex;
    gap: 16px;
    border-top: 1px solid var(--color-hairline);
    padding-top: 32px;
  }
  .nav-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    transition:
      background 150ms ease,
      border-color 150ms ease;
  }
  .nav-link:hover {
    background: var(--color-card-bg-hover);
    border-color: var(--color-border-hover);
  }
  .nav-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .nav-spacer {
    flex: 1;
  }
  .nav-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .nav-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    color: var(--color-heading);
  }

  @media (max-width: 600px) {
    .project {
      padding-block: 44px 72px;
    }
    .sections {
      gap: 36px;
    }
    .prompt-block pre {
      padding: 16px;
      max-height: 420px;
    }
    .project-nav {
      flex-direction: column;
    }
    .nav-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
