---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
const firstProject = sorted[0];
const isProjectPage = Astro.url.pathname.startsWith('/projects/');
const projectList = sorted.map((p) => ({ slug: p.id, order: p.data.order }));
---

<footer class="site-footer" data-footer data-projects={JSON.stringify(projectList)}>
  <span class="site-name">projecttrack.dev</span>
  {
    isProjectPage ? (
      <a href="/#roadmap" class="cta">
        Back to the roadmap &rarr;
      </a>
    ) : (
      firstProject && (
        <a href={`/projects/${firstProject.id}/`} class="cta" data-continue-link>
          Begin with project 01 &rarr;
        </a>
      )
    )
  }
</footer>

<script>
  import { isProjectDone } from '../lib/progress';

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const link = document.querySelector<HTMLAnchorElement>('[data-continue-link]');
  if (footer && link) {
    let projectList: { slug: string; order: number }[] = [];
    try {
      projectList = JSON.parse(footer.dataset.projects ?? '[]');
    } catch {
      projectList = [];
    }

    const next = projectList.find((p) => !isProjectDone(p.slug));
    if (next) {
      link.href = `/projects/${next.slug}/`;
      link.textContent = `Continue with project ${String(next.order).padStart(2, '0')} →`;
    } else if (projectList[0]) {
      link.href = `/projects/${projectList[0].slug}/`;
      link.textContent = 'Begin with project 01 →';
    }
  }
</script>

<style>
  .site-footer {
    max-width: 1360px;
    margin: 0 auto;
    padding: 34px 5vw 60px;
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }
  .site-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cta {
    font-size: 14px;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .cta:hover {
    color: var(--color-accent-hover);
  }
</style>
