---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  color: string;
  isCapstone?: boolean;
}

const { entry, color, isCapstone = false } = Astro.props;
const orderLabel = String(entry.data.order).padStart(2, '0');
---

<a
  href={`/projects/${entry.id}/`}
  class:list={['project-row', { capstone: isCapstone }]}
  style={`--phase-color: ${color};`}
>
  <span class="dot" aria-hidden="true"></span>
  <span class="card">
    <span class="card-top">
      <span class="order">{orderLabel}</span>
      <span class="title">{entry.data.title}</span>
    </span>
    <span class="summary">{entry.data.summary}</span>
  </span>
</a>

<style>
  .project-row {
    position: relative;
    display: block;
    padding-left: 40px;
    text-decoration: none;
  }
  .dot {
    position: absolute;
    left: -1px;
    top: 26px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #ffffff;
    transform: translateX(-50%);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--phase-color) 14%, transparent),
      0 0 12px 3px color-mix(in srgb, var(--phase-color) 70%, transparent),
      0 0 30px 8px color-mix(in srgb, var(--phase-color) 30%, transparent);
    transition: transform 180ms ease;
  }
  .project-row:hover .dot {
    transform: translateX(-50%) scale(1.3);
  }
  .card {
    display: block;
    padding: 18px 26px 19px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card-bg);
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }
  .project-row:hover .card {
    background: var(--color-card-bg-hover);
    border-color: var(--color-border-hover);
  }
  .card-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .order {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--phase-color);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.015em;
    color: var(--color-heading);
  }
  .summary {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .project-row.capstone .dot {
    width: 15px;
    height: 15px;
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--phase-color) 16%, transparent),
      0 0 16px 4px color-mix(in srgb, var(--phase-color) 75%, transparent),
      0 0 40px 11px color-mix(in srgb, var(--phase-color) 32%, transparent);
  }
  .project-row.capstone .card {
    border-color: color-mix(in srgb, var(--phase-color) 22%, transparent);
    background: color-mix(in srgb, var(--phase-color) 5%, transparent);
  }

  @media (max-width: 720px) {
    .project-row {
      padding-left: 30px;
    }
    .card {
      padding: 15px 16px 16px;
    }
  }
</style>
