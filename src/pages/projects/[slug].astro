---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: i > 0 ? sorted[i - 1] : null,
      nextEntry: i < sorted.length - 1 ? sorted[i + 1] : null,
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
---

<ProjectLayout entry={entry} prevEntry={prevEntry} nextEntry={nextEntry} />
